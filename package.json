{
  "name": "declare-cc",
  "version": "2.0.0-alpha.0",
  "description": "Future-driven meta-prompting engine for agentic development",
  "type": "module",
  "bin": {
    "dcl": "dist/cli.js",
    "declare": "dist/cli.js"
  },
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:server": "bun run --hot src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build && bun build src/server/index.ts --outdir dist --target bun && bun build src/cli/index.ts --outdir dist --target bun",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.10.0",
    "@modelcontextprotocol/sdk": "^1.26.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code-sdk": "^0.1.0",
    "@deco/ui": "workspace:*",
    "@playwright/test": "^1.50.0",
    "@tanstack/react-query": "^5.90.0",
    "@tanstack/react-router": "^1.139.0",
    "@tanstack/router-vite-plugin": "^1.139.0",
    "@types/bun": "^1.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^3.0.0"
  }
}
